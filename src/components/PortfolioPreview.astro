---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, slug } = Astro.props.project;

---

<a class="card glass-panel" href={`/work/${slug}`} data-image-src={data.img}>
	<span class="title">{data.title}</span>
	<Image 
		src={data.img} 
		alt={data.img_alt || ''} 
		width={800} 
		height={600} 
		loading="lazy" 
		decoding="async" 
		fetchpriority="low"
		widths={[400, 800, 1200]}
		sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 800px"
		quality={80}
		data-optimize
	/>
</a>

<style>
	.card {
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 11rem;
		border-radius: 1.25rem;
		overflow: hidden;
		gap: 0.35rem;
		padding: 0.75rem;
		background:
			linear-gradient(155deg, color-mix(in srgb, var(--accent-regular) 16%, transparent), transparent 55%),
			linear-gradient(180deg, color-mix(in srgb, var(--glass-regular) 80%, transparent), color-mix(in srgb, var(--glass-thin) 60%, transparent));
		border: 1px solid var(--glass-stroke-soft);
		box-shadow: var(--glass-shadow-light);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: box-shadow var(--theme-transition), transform var(--theme-transition);
		will-change: transform, box-shadow;
	}

	.card:hover {
		box-shadow: var(--glass-shadow-medium);
		transform: translateY(-2px);
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.25rem;
		padding: 0.45rem 0.9rem;
		background: color-mix(in srgb, var(--glass-ultra-thick) 70%, transparent);
		color: var(--gray-50);
		border-radius: 0.75rem;
		border: 1px solid var(--glass-stroke-soft);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 14%, transparent);
	}

	img {
		grid-area: 1 / 1 / 3 / 3;
		width: calc(100% - 0.1rem);
		height: calc(100% - 0.1rem);
		margin: auto;
		object-fit: cover;
		transition: transform 0.3s ease, border-radius 0.3s ease, filter 0.3s ease;
		border-radius: 0.9rem;
		box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent);
		will-change: transform, filter;
	}

	.card:hover img {
		transform: scale(1.02);
		border-radius: 1.1rem;
		filter: saturate(1.05);
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
			overflow: hidden;
			padding: 1rem;
		}

		.title {
			border-radius: 1rem;
		}

		img {
			border-radius: 1.25rem;
		}

		.card:hover img {
			border-radius: 1.5rem;
		}
	}
</style>
