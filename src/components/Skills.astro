---
import Icon from './Icon.astro';
interface Props {
	class?: string | string[] | Record<string, boolean>;
}

const { class: className } = Astro.props;
---

<section class:list={['box skills glass-panel flush', className]}>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="linux" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>OS Architect</h2>
		<p>Designing functional operating systems based on the Unix and Linux kernels. Along with understanding the advanced concepts of Operating Systems.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="trophy" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Startup Beginner</h2>
		<p>Created my own startup called UniSoft (Morales Research Corp.) in 2018 to propel my experiences in Computer Science and Software Engineering.</p>
	</div>
	<div class="stack gap-2 lg:gap-4">
		<Icon icon="strategy" color="var(--accent-regular)" size="2.5rem" gradient />
		<h2>Strategy-Minded</h2>
		<p>Played a role as a team player and leader in leading development teams to successfully bring a product or idea to life.</p>
	</div>
</section>

<style>
	.box {
		padding: clamp(1.5rem, 3vw, 2.25rem);
		border-radius: 1.5rem;
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	@supports (content-visibility: auto) {
		.skills {
			content-visibility: auto;
			contain-intrinsic-size: 1px 420px;
		}
	}

	.skills h2 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-400);
	}

	@media (min-width: 50em) {
		.box {
			border-radius: 1.75rem;
			padding: clamp(2rem, 3vw, 2.75rem);
		}

		.skills {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 5rem;
		}

		.skills h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
