---
import Icon from './Icon.astro';
import packageJson from '../../package.json';
const currentYear = new Date().getFullYear();
const endCopyYear = new Date().getFullYear() + 2;
const astroVersion = packageJson.dependencies?.astro?.replace(/^[\^~>=<\s]+/, '') || 'unknown';
---

<footer class="footer-shell glass-panel flush">
	<div class="group">
		<p>
			Designed & Developed in Austin, Texas with <a href="https://astro.build/">Astro {astroVersion}</a>
			<Icon icon="rocket-launch" size="1.2em" />
		</p>
		<p>&copy; {currentYear} - {endCopyYear} Abdon Morales.</p>
	</div>
	<p class="socials">
		<!--<a href="https://x.com/AbdonMorales7"> Twitter</a>-->
		<a href="https://github.com/abdonmorales"> GitHub</a>
		<a href="https://gitlab.com/abdonmorales"> GitLab</a>
	</p>
</footer>
<style>
	.footer-shell {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-top: auto;
		padding: 2.5rem clamp(1.5rem, 3vw, 3rem);
		text-align: center;
		color: var(--gray-400);
		font-size: var(--text-sm);
		border-radius: 1.5rem;
		backdrop-filter: var(--glass-blur-light);
		-webkit-backdrop-filter: var(--glass-blur-light);
	}

	.footer-shell a {
		color: var(--gray-400);
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.footer-shell a:hover,
	.footer-shell a:focus {
		text-decoration-color: currentColor;
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	@media (min-width: 50em) {
		.footer-shell {
			flex-direction: row;
			justify-content: space-between;
			padding: 2.5rem clamp(2rem, 4vw, 4rem);
		}

		.group {
			flex-direction: row;
			gap: 1rem;
			flex-wrap: wrap;
		}

		.socials {
			justify-content: flex-end;
		}
	}
</style>
