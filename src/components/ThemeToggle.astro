---
import Icon from './Icon.astro';
---

<theme-toggle>
	<button>
		<span class="sr-only">Toggle color theme</span>
		<span class="icon light"><Icon icon="sun" /></span>
		<span class="icon dark"><Icon icon="moon-stars" /></span>
	</button>
</theme-toggle>

<style>
	button {
		display: flex;
		border: 0;
		border-radius: 999rem;
		padding: 0;
		background-color: var(--gray-999);
		box-shadow: inset 0 0 0 1px var(--accent-overlay);
		cursor: pointer;
		overflow: hidden;
		transition: box-shadow var(--theme-transition), transform var(--theme-transition);
	}

	.icon {
		z-index: 1;
		position: relative;
		display: flex;
		padding: 0.5rem;
		width: 2rem;
		height: 2rem;
		font-size: 1rem;
		color: var(--accent-overlay);
	}

	.icon.light::before {
		content: '';
		z-index: -1;
		position: absolute;
		inset: 0;
		background-color: var(--accent-regular);
		border-radius: 999rem;
	}

	:global(.theme-dark) .icon.light::before {
		transform: translateX(100%);
	}

	:global(.theme-dark) .icon.dark,
	:global(html:not(.theme-dark)) .icon.light,
	button[aria-pressed='false'] .icon.light {
		color: var(--accent-text-over);
	}

	@media (prefers-reduced-motion: no-preference) {
		.icon,
		.icon.light::before {
		transition:
			transform var(--theme-transition),
			color var(--theme-transition),
			box-shadow var(--theme-transition);
	}
	}

	@media (forced-colors: active) {
		.icon.light::before {
			background-color: SelectedItem;
		}
	}
</style>

<script>
	class ThemeToggle extends HTMLElement {
		button?: HTMLButtonElement;
		observer?: MutationObserver;

		connectedCallback() {
			if (this.button) return;
			this.button = this.querySelector('button')!;

			// Sync button state with current theme.
			const sync = () => {
				const isDark = document.documentElement.classList.contains('theme-dark');
				this.button?.setAttribute('aria-pressed', String(isDark));
				this.button?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
			};

			const setTheme = (dark: boolean) => {
				document.documentElement.classList[dark ? 'add' : 'remove']('theme-dark');
				// Persist immediately for next visit.
				try {
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				} catch (_) {}
				sync();
			};

			this.button.addEventListener('click', () => setTheme(!document.documentElement.classList.contains('theme-dark')));

			// Observe external theme changes (e.g., system change or another toggle) to keep UI in sync.
			this.observer = new MutationObserver(sync);
			this.observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

			// Initial sync.
			sync();
		}

		disconnectedCallback() {
			this.observer?.disconnect();
		}
	}

	if (!customElements.get('theme-toggle')) {
		customElements.define('theme-toggle', ThemeToggle);
	}
</script>
