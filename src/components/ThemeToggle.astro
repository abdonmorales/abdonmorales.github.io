---
import Icon from './Icon.astro';
---

<theme-toggle>
	<button type="button" aria-pressed="false">
		<span class="sr-only">Toggle color theme</span>
		<span class="halo" aria-hidden="true"></span>
		<span class="glyph sun" aria-hidden="true"><Icon icon="sun" /></span>
		<span class="glyph moon" aria-hidden="true"><Icon icon="moon-stars" /></span>
	</button>
</theme-toggle>

<style>
	button {
		--size: 2.4rem;
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--size);
		height: var(--size);
		border: 1px solid color-mix(in srgb, var(--gray-800) 45%, transparent);
		border-radius: 999rem;
		padding: 0;
		background:
			linear-gradient(145deg, color-mix(in srgb, #fff 10%, transparent), transparent 55%),
			linear-gradient(165deg, color-mix(in srgb, var(--glass-regular) 60%, transparent), color-mix(in srgb, var(--glass-thin) 40%, transparent));
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent),
			var(--glass-shadow-light);
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		cursor: pointer;
		overflow: hidden;
		transition:
			box-shadow var(--theme-transition),
			transform var(--theme-transition),
			border-color var(--theme-transition),
			background-color var(--theme-transition);
		will-change: transform, box-shadow;
	}

	.halo {
		position: absolute;
		inset: -6%;
		border-radius: inherit;
		background: radial-gradient(circle at 35% 35%, color-mix(in srgb, #fff 14%, transparent), transparent 60%);
		mix-blend-mode: soft-light;
		opacity: 0.55;
		pointer-events: none;
	}

	.glyph {
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		height: 1.25rem;
		font-size: 1.05rem;
		color: var(--gray-300);
		pointer-events: none;
		position: absolute;
		inset: 0;
		margin: auto;
		transition: opacity var(--theme-transition), transform var(--theme-transition);
	}

	.sun {
		opacity: 1;
		transform: translateY(0);
		color: color-mix(in srgb, #f6d27a 80%, var(--gray-200));
	}

	.moon {
		opacity: 0;
		transform: translateY(6%);
		color: color-mix(in srgb, #c6ddff 78%, var(--gray-300));
	}

	:global(.theme-dark) button {
		border-color: color-mix(in srgb, var(--glass-stroke) 80%, transparent);
		background: linear-gradient(150deg, color-mix(in srgb, var(--glass-regular) 46%, transparent), color-mix(in srgb, var(--glass-thin) 34%, transparent));
	}

	:global(.theme-dark) .sun {
		opacity: 0;
		transform: translateY(-6%);
		color: color-mix(in srgb, var(--gray-400) 88%, var(--accent-regular));
	}

	:global(.theme-dark) .moon {
		opacity: 1;
		transform: translateY(0);
		color: color-mix(in srgb, #e6f1ff 90%, var(--gray-100));
	}

	button:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 3px;
	}

	button:hover {
		box-shadow: var(--glass-shadow-medium);
		transform: translateY(-1px);
	}

	@media (prefers-reduced-motion: no-preference) {
		button,
		.glyph {
			transition:
				transform var(--theme-transition),
				color var(--theme-transition),
				box-shadow var(--theme-transition),
				border-color var(--theme-transition),
				opacity var(--theme-transition);
		}
	}

	@media (forced-colors: active) {
		button {
			border: 1px solid ButtonText;
			background: ButtonFace;
		}
		.glyph {
			color: ButtonText;
		}
	}
</style>

<script>
	class ThemeToggle extends HTMLElement {
		button?: HTMLButtonElement;
		observer?: MutationObserver;

		connectedCallback() {
			if (this.button) return;
			this.button = this.querySelector('button')!;

			const sync = () => {
				const isDark = document.documentElement.classList.contains('theme-dark');
				this.button?.setAttribute('aria-pressed', String(isDark));
				this.button?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
			};

			const setTheme = (dark: boolean) => {
				document.documentElement.classList[dark ? 'add' : 'remove']('theme-dark');
				try {
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				} catch (_) {}
				sync();
			};

			this.button.addEventListener('click', () => setTheme(!document.documentElement.classList.contains('theme-dark')));

			// Observe external theme changes (e.g., system change or another toggle) to keep UI in sync.
			this.observer = new MutationObserver(sync);
			this.observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

			// Initial sync.
			sync();
		}

		disconnectedCallback() {
			this.observer?.disconnect();
		}
	}

	if (!customElements.get('theme-toggle')) {
		customElements.define('theme-toggle', ThemeToggle);
	}
</script>
