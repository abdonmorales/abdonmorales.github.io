---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'My Projects', href: '/work/' },
	{ label: 'Coursework', href: '/coursework/' },
	{ label: 'About', href: '/about/' },
	{ label: 'UTCS Webpage', href: 'https://cs.utexas.edu/~abdonm'},
];

/** Icon links to social media — edit these with links to your profiles! */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	/**{ label: 'Twitter', href: 'https://x.com/AbdonMorales7', icon: 'twitter-logo' },*/
	{ label: 'GitHub', href: 'https://github.com/abdonmorales', icon: 'github-logo' },
	{ label: 'GitLab', href: 'https://gitlab.com/abdonmorales', icon: 'gitlab-logo'},
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/abdonmorales/', icon: 'linkedin-logo' },
];
---

<nav class="nav-shell glass-panel flush">
	<div class="menu-header">
		<a href="/" class="site-title">
			<Icon icon="terminal-window" color="var(--accent-regular)" size="1.6em" gradient />
			 Abdon Morales
		</a>
	<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<Icon icon="list" />
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								'link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<noscript>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								'link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
			{/*
				TODO: Re-enable ThemeToggle after redesign; currently removed per request.
			*/}
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			const toggle = () => setExpanded(menu.hidden);

			// Toggle menu visibility when the menu button is clicked or activated via keyboard.
			btn.addEventListener('click', toggle);
			btn.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					toggle();
				}
			});

			// Close with Escape.
			window.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !menu.hidden) {
					setExpanded(false);
					btn.focus();
				}
			});

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			const mediaQueries = window.matchMedia('(min-width: 50em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-family: var(--font-brand);
		width: min(100%, calc(var(--page-max-width) + 3rem));
		margin-inline: auto;
		padding: clamp(0.75rem, 2vw, 1.25rem);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		border-radius: 1.5rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 0.35rem 0.5rem 0.35rem 0.75rem;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
		text-shadow: 0 1px 0 color-mix(in srgb, #fff 30%, transparent);
	}

	.menu-button {
		position: relative;
		display: flex;
		border-radius: 999rem;
		padding: 0.6rem;
		font-size: 1.35rem;
		color: var(--gray-200);
		border: 1px solid var(--glass-stroke-soft);
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--glass-thick) 80%, transparent),
			color-mix(in srgb, var(--glass-regular) 65%, transparent)
		);
		box-shadow: var(--glass-shadow-light);
		-webkit-backdrop-filter: var(--glass-blur-light);
		backdrop-filter: var(--glass-blur-light);
		transition:
			background-color var(--theme-transition),
			color var(--theme-transition),
			transform var(--theme-transition);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--glass-ultra-thick) 82%, transparent),
			color-mix(in srgb, var(--glass-regular) 70%, transparent)
		);
		transform: translateY(-1px);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;
		content: '';
		background: linear-gradient(145deg, color-mix(in srgb, #fff 15%, transparent), transparent);
		border-radius: 999rem;
		z-index: -1;
		opacity: 0.9;
	}

	.menu-content {
		position: absolute;
		left: clamp(0.5rem, 2vw, 1.25rem);
		right: clamp(0.5rem, 2vw, 1.25rem);
		top: calc(100% - 0.5rem);
		max-height: 80vh;
		overflow-y: auto;
		scrollbar-width: thin;
		padding: 0.35rem;
		border-radius: 1.25rem;
		border: 1px solid var(--glass-stroke-soft);
		background: linear-gradient(
			160deg,
			color-mix(in srgb, var(--glass-regular) 60%, transparent),
			color-mix(in srgb, var(--glass-thin) 48%, transparent)
		);
		box-shadow: var(--glass-shadow-medium);
		backdrop-filter: var(--glass-blur-light);
		-webkit-backdrop-filter: var(--glass-blur-light);
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 1.25rem 1.5rem;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--glass-regular) 75%, transparent),
			color-mix(in srgb, var(--glass-thin) 60%, transparent)
		);
		border-radius: 1.1rem;
		border: 1px solid var(--glass-stroke-soft);
		box-shadow: var(--glass-shadow-light);
	}

	.link {
		display: inline-block;
		color: var(--gray-200);
		text-decoration: none;
		letter-spacing: 0.01em;
		font-weight: 500;
	}

	.link.active {
		color: var(--gray-0);
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1rem 1.35rem 1.25rem;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--glass-regular) 70%, transparent),
			color-mix(in srgb, var(--glass-thin) 55%, transparent)
		);
		border-radius: 1.1rem;
		border: 1px solid var(--glass-stroke-soft);
		box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 12%, transparent);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--accent-dark);
		transition: color var(--theme-transition), 
					transform var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		color: var(--accent-text-over);
		transform: translateY(-3px);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
		margin-left: auto;
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 1rem 1.5rem;
			gap: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-lg);
		}

		.menu-content {
			display: contents;
			position: static;
			padding: 0;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			font-size: var(--text-sm);
			border-radius: 999rem;
			border: 1px solid var(--glass-stroke-soft);
			padding: 0.35rem 0.45rem;
			background: linear-gradient(
				140deg,
				color-mix(in srgb, var(--glass-regular) 72%, transparent),
				color-mix(in srgb, var(--glass-thin) 55%, transparent)
			);
			box-shadow: var(--glass-shadow-medium);
		}

		.link {
			padding: 0.5rem 1rem;
			border-radius: 999rem;
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition);
		}

		.link:hover,
		.link:focus {
			color: var(--gray-0);
			background-color: color-mix(in srgb, var(--accent-regular) 15%, transparent);
		}

		.link.active {
			color: var(--accent-text-over);
			background-color: color-mix(in srgb, var(--accent-regular) 85%, transparent);
			box-shadow: 0 6px 18px color-mix(in srgb, var(--accent-regular) 25%, transparent);
		}

		.menu-footer {
		--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}
	@media (forced-colors: active) {
		.link.active {
			color: SelectedItem;
		}
	}
</style>
