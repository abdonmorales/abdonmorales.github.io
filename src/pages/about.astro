---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
	title="About | Abdon Morales"
	description="About Abdon Morales' Work and Educational Background"
>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About Me"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Abdon Morales at the University of Texas at Austin, August 2023"
					loading="lazy"
					decoding="async"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>I'm pursuing a Bachelor of Science in Economics at the University of Texas at Austin, with an anticipated graduation in May 2027. My journey combines a strong academic foundation with hands-on experience in technology.</p>
					
					<p>In the technical realm, I'm proficient in Git, C++, C, Python, and Linux, with intermediate abilities in shell scripting, AI, and ChatGPT. As a native Spanish speaker, I'm fluent in both Mexican and Spanish dialects, enabling me to communicate effectively in international contexts.</p>
					
					<p>Currently, I'm expanding my knowledge in Java, Assembly language, C, and web development. My academic training includes courses such as Calculus I and II, Matrices and Matrix Calculations, Micro and Macroeconomics, and Engineering Physics, which have strengthened my analytical capabilities.</p>
					
					<p>Outside the classroom, I actively develop software projects that can be seen on my GitHub profile. I've cultivated leadership skills as a team leader and CEO of my own startup, experiences that have allowed me to grow professionally.</p>
					
					<p>In my free time, I enjoy soccer, video gaming, and programming as a hobby—activities that not only serve as creative outlets but also keep me grounded and connected to my community. My goal is to inspire positive change, highlighting education as a catalyst for progress. I firmly believe in seizing opportunities in our interconnected world and, through continuous learning, aspire to contribute significantly to the field of software engineering and beyond.</p>
				</div>
				<section>
					<h2 class="section-title">Education</h2>
					<div class="content education-card">
						<div class="education-header">
							<p class="university">University of Texas at Austin</p>
							<p class="degree">Economics, Bachelor of Science</p>
							<p class="certificate">Certificate in Computer Science and Engineering</p>
							<p class="graduation-date">Expected graduation date: May 2027</p>
						</div>
					</div>
				</section>
				<section>
					<h2 class="section-title">Skills</h2>
					<div class="content">
						<div class="skills-grid">
							<div class="skill-category">
								<h3>Programming Languages</h3>
								<ul>
									<li><span class="skill-level">Intermediate:</span> Python, BASIC, Shell scripting (Bash)</li>
									<li><span class="skill-level">Advanced:</span> Java</li>
									<li><span class="skill-level">Basic:</span> C, C++, R</li>
								</ul>
							</div>
							<div class="skill-category">
								<h3>Tools & Systems</h3>
								<ul>
									<li><span class="skill-level">Intermediate:</span> Git</li>
									<li><span class="skill-level">Advanced:</span> macOS, Linux</li>
								</ul>
							</div>
						</div>
					</div>
				</section>
				<section>
					<h2 class="section-title">Community Involvement</h2>
					<div class="content">
						<div class="involvement-item">
							<h3>ACM (Association of Computing Machinery)</h3>
							<p class="involvement-role">Student Member</p>
							<p class="involvement-date">September 2023 &ndash; Present</p>
							<p class="involvement-location">UT @ Austin, Texas</p>
						</div>
						
						<div class="involvement-item">
							<h3>HACS (Hispanic Association of Computer Science)</h3>
							<p class="involvement-role">Student Member</p>
							<p class="involvement-date">January 2024 &ndash; Present</p>
							<p class="involvement-location">UT @ Austin, Texas</p>
						</div>
						
						<div class="involvement-item">
							<h3>IEEE (Institute of Electrical and Electronics Engineers)-UT</h3>
							<p class="involvement-role">Student Member</p>
							<p class="involvement-date">February 2024 &ndash; Present</p>
							<p class="involvement-location">UT @ Austin, Texas</p>
						</div>
					</div>
				</section>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
	
	/* Estilos para la sección Education */
	.education-card {
		background-color: var(--gray-999);
		border-radius: 1rem;
		padding: 1.5rem;
		box-shadow: var(--shadow-sm);
		transition: box-shadow 0.25s ease;
		border: 1px solid var(--gray-800);
	}
	
	:global(.theme-dark) .education-card {
		background-color: var(--gray-800);
		border-color: var(--gray-700);
	}
	
	.education-card:hover {
		box-shadow: var(--shadow-md);
	}
	
	.university {
		font-weight: bold;
		font-size: var(--text-lg);
		color: var(--gray-0);
	}
	
	.degree {
		font-weight: bold;
		font-style: italic;
		color: var(--accent-regular);
		margin-top: 0.25rem;
	}
	
	.certificate {
		margin-top: 0.75rem;
	}
	
	.graduation-date {
		font-style: italic;
		margin-top: 1rem;
		color: var(--gray-300);
	}
	
	/* Estilos para la sección Skills */
	.skills-grid {
		display: grid;
		gap: 2rem;
		margin-top: 0.5rem;
	}
	
	@media (min-width: 768px) {
		.skills-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	
	.skill-category h3 {
		color: var(--accent-regular);
		font-size: var(--text-md);
		margin-bottom: 0.75rem;
		border-bottom: 1px solid var(--gray-800);
		padding-bottom: 0.25rem;
	}
	
	.skill-category ul {
		list-style-type: none;
		padding: 0;
		margin: 0;
	}
	
	.skill-category li {
		margin-bottom: 0.5rem;
		line-height: 1.6;
	}
	
	.skill-level {
		font-weight: bold;
		color: var(--gray-200);
	}
	
	/* Ajustes para el tema oscuro */
	:global(.theme-dark) .university,
	:global(.theme-dark) .section-title {
		color: var(--gray-200);
	}
	
	:global(.theme-dark) .skill-category h3 {
		border-bottom-color: var(--gray-700);
	}
	
	/* Estilos para Community Involvement */
	.involvement-item {
		margin-bottom: 2rem;
		padding: 1rem;
		border-left: 3px solid var(--accent-regular);
		background-color: var(--gray-900);
		border-radius: 0 0.5rem 0.5rem 0;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-800);
		border-left-width: 3px;
	}
	
	.involvement-item:hover {
		transform: translateX(5px);
		box-shadow: var(--shadow-md);
		border-left-color: var(--accent-dark);
	}
	
	.involvement-item h3 {
		font-size: var(--text-md);
		color: var(--gray-0);
		margin-bottom: 0.5rem;
		font-weight: 600;
	}
	
	.involvement-role {
		font-style: italic;
		margin-bottom: 0.25rem;
		color: var(--gray-100);
	}
	
	.involvement-date {
		color: var(--accent-regular);
		font-weight: 500;
		font-size: var(--text-sm);
		margin-bottom: 0.25rem;
	}
	
	.involvement-location {
		font-weight: bold;
		font-size: var(--text-sm);
		color: var(--gray-300);
	}
	
	:global(.theme-dark) .involvement-item {
		background-color: var(--gray-800);
		border-left-color: var(--accent-light);
	}
	
	:global(.theme-dark) .involvement-item h3 {
		color: var(--gray-200);
	}
</style>
